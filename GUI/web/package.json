{
  "name": "conscious-investments-hq-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:static": "tsc --noEmit && VITE_STATIC=1 vite build --outDir dist-site",
    "deploy": "npm run build:static && wrangler pages deploy dist-site --project-name conscious-investments-hq",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
