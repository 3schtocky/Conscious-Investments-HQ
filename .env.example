# Anthropic API key for the office (billed separately from a Claude Pro subscription).
# Create one at https://console.anthropic.com and set a monthly spend limit there as a backstop.
ANTHROPIC_API_KEY=

# The Captain's sign-in password for the public site (`hq serve --public`). At least 16
# characters. Create one with: uv run hq captain-password
HQ_CAPTAIN_PASSWORD=
